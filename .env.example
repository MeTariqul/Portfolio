# ── Database (Supabase free tier, works with Neon too) ────────────────
# Transaction pooler URL (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true&connection_limit=5"
# Direct URL (port 5432) — used by prisma db push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Auth.js ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the site (canonical URLs, OG, auth redirects).
# Without it the site falls back to https://$VERCEL_URL, or localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Initial admin account (only read by `npm run db:seed`) ─────────────
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# ── Media storage (Supabase, bucket: portfolio-media) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only: uploads and deletes. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Email (Gmail SMTP: contact notifications and licence keys) ─────────
# The account mail is sent *from*. Gmail rewrites any other From address
# unless it is a verified alias there, so this is also the SMTP login.
# The password must be a 16-character App Password, not the account
# password — that needs 2-Step Verification turned on first:
# https://myaccount.google.com/apppasswords
# Without both values email is skipped; the contact form still saves
# messages, and a licence request is logged as Failed so you can resend.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD=""
# Optional, 465 by default. 587 (STARTTLS) is the fallback if a host ever
# blocks 465; Vercel leaves both open. Port 25 is blocked by Vercel.
# GMAIL_SMTP_PORT="465"

# Where contact-form notifications are delivered. Any address, and it does
# NOT change the address printed on the site: that one is `email` in
# lib/site.ts.
CONTACT_EMAIL="you@example.com"

# ── Rate limiting / Redis (optional, Upstash free tier) ────────────────
# These back the counters for license keys and sign-in. Without them those
# limits run on the database instead, so they are still global; the page-view
# beacon always uses the cheap in-process counter.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ── Analytics ──────────────────────────────────────────────────────────
# Vercel Analytics is enabled automatically when Web Analytics is turned
# on in the Vercel project dashboard. No key needed.

# ── Legacy keys from the previous site (kept in .env, currently unused) ─
# GROQ_API_KEY, CLOUDINARY_*
