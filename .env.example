# Copy to .env.local and fill in the values.
# NEVER commit .env* files — they are gitignored.

# Contact form delivery via Resend (https://resend.com)
# Without these, the form runs in demo mode (records attempts, sends nothing).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=hello@metariqul.dev

# Live visitor counter via Upstash Redis (https://upstash.com) — free tier
# Create a DB, then copy REST URL + token here. Without these, the counter hides itself.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Admin panel + message storage via Supabase (https://supabase.com)
# 1. Create a project, run the SQL from AGENTS.md §5.8 to create the `messages` table + RLS.
# 2. Create the admin user in Dashboard → Authentication → Users (email + password).
# 3. Copy Project Settings → API: URL + anon key (public — safe in the client bundle),
#    and the service_role key (SERVER ONLY — never expose it client-side).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # server-only: inserts contact messages

# User confirmation emails via Brevo (https://brevo.com) — Transactional API
# Create an API key, and verify the sender address (must match CONTACT_EMAIL).
# Without this, no confirmation email is sent (form still stores the message).
BREVO_API_KEY=xxxxxxxxxxxxxxxxxxxx

# AI-powered confirmation emails via Groq (https://console.groq.com)
# Free tier: 14,400 requests/day, Llama 3.3 70B
# Without this, falls back to static confirmation email.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx