# ── Database (Supabase free tier, works with Neon too) ────────────────
# Transaction pooler URL (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true&connection_limit=5"
# Direct URL (port 5432) — used by prisma db push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Auth.js ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the site (canonical URLs, OG, auth redirects).
# Without it the site falls back to https://$VERCEL_URL, or localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Initial admin account (only read by `npm run db:seed`) ─────────────
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# ── Media storage (Supabase, bucket: portfolio-media) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only: uploads and deletes. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Email (Brevo, contact notifications) ───────────────────────────────
# Without a key the contact form still saves messages to the database.
BREVO_API_KEY=""
# From address for notifications (must be verified in Brevo).
# This does NOT change the address printed on the site: that one is
# `email` in lib/site.ts.
CONTACT_EMAIL="you@example.com"

# ── Rate limiting / Redis (optional, Upstash free tier) ────────────────
# Without these, rate limiting falls back to in-memory (dev only).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ── Analytics ──────────────────────────────────────────────────────────
# Vercel Analytics is enabled automatically when Web Analytics is turned
# on in the Vercel project dashboard. No key needed.

# ── Legacy keys from the previous site (kept in .env, currently unused) ─
# RESEND_API_KEY, GROQ_API_KEY, CLOUDINARY_*
