# syntax=docker/dockerfile:1

# A production image for this app.
#
# Three stages, so the runtime image carries only what it needs to serve
# traffic: the standalone server, the static assets, and the Prisma query
# engine. The build tools, the dev dependencies and the source never reach
# the final layer.
#
# Build:  docker build -t portfolio .
# Run:    docker run -p 3000:3000 --env-file .env portfolio
#
# The image expects DATABASE_URL, DIRECT_URL, AUTH_SECRET, GMAIL_USER and
# GMAIL_APP_PASSWORD in the environment. NEXT_STANDALONE=1 is what makes
# next.config.ts turn on the standalone output — it is off everywhere else,
# so `next start` keeps working locally and on Vercel.

# ─── Dependencies ───────────────────────────────────────────────────────
# Installed on their own so the layer is reused whenever only the
# application source changes.
FROM node:22-slim AS deps
WORKDIR /app
# openssl is what Prisma's query engine links against; without it the
# container starts and then fails on the first query.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY prisma ./prisma
# --ignore-scripts: the postinstall hook (prisma generate) runs in the
# build stage, where the full source is available.
RUN npm ci --ignore-scripts

# ─── Build ──────────────────────────────────────────────────────────────
FROM node:22-slim AS builder
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_STANDALONE=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# The client has to exist before the build: the pages import it.
RUN npx prisma generate
RUN npm run build

# ─── Runtime ────────────────────────────────────────────────────────────
FROM node:22-slim AS runner
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# The standalone server, with the traced node_modules already inside it.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
# The static assets and the public files are not part of the standalone
# output and have to be copied in by hand.
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
# Prisma's query engine is a native binary that output tracing does not
# always pick up on its own. Copying it explicitly is what keeps
# "PrismaClientInitializationError" out of the container logs.
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/@prisma ./node_modules/@prisma

USER nextjs
EXPOSE 3000
# /robots.txt is generated by the framework and touches no database, so it
# answers as long as the server itself is up.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/robots.txt').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
