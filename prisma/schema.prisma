// Portfolio content model. Designed to be extensible:
// new content types get their own model; free-form pages use `Page.blocks`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum ExperienceKind {
  EDUCATION
  FREELANCE
  WORK
}

// Single admin account. Password is scrypt-hashed (see lib/password.ts).
model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  // What this account may do. OWNER is the full set; EDITOR can work on
  // content but cannot delete things, ban a user, or change an app's keys.
  // One account is the norm here, but the role is what makes a second
  // account safe to add later.
  role         AdminRole      @default(OWNER)
  sessions     AdminSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

enum AdminRole {
  OWNER // everything, including deletes, bans and key rotation
  EDITOR // content only
}

// One row per signed-in admin device. At most two rows exist per user:
// when a third device signs in, the oldest row is deleted, so that
// device is signed out on its next request. See the jwt callback in
// lib/auth.ts.
model AdminSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String     @db.Text
  contentMD      String     @db.Text
  coverImage     String?
  coverAlt       String?
  category       String?
  tags           String[]
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?
  featured       Boolean    @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  attachments PostAttachment[]

  @@index([status, publishedAt])
  @@index([status, featured, publishedAt])
  @@index([tags])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String   @db.Text
  problem     String   @db.Text
  solutionMD  String   @db.Text
  learnedMD   String   @db.Text
  stack       String[]
  category    String
  screenshots Json // [{ url, alt }] — alt required by admin validation
  liveUrl     String?
  githubUrl   String?
  // Direct file URL behind the public "Download" button, plus the original
  // filename (it names the file in Content-Disposition). Null = no button.
  // Uploaded files live in Supabase Storage under `projects/`.
  downloadUrl      String?
  downloadFilename String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, order])
}

// Skills grouped by area (Frontend, Backend, ...).
model Skill {
  id    String @id @default(cuid())
  name  String
  group String
  order Int    @default(0)

  @@index([group, order])
}

// About-page timeline (education, freelance work, jobs).
model Experience {
  id          String        @id @default(cuid())
  kind        ExperienceKind
  title       String
  org         String
  period      String
  description String        @db.Text
  order       Int           @default(0)

  @@index([order])
}

model Service {
  id           String  @id @default(cuid())
  title        String
  descriptionMD String @db.Text
  priceNote    String?
  order        Int     @default(0)

  @@index([order])
}

// Contact-form submissions.
model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  content   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// Uploaded files (Supabase Storage). `alt` is required — enforced in the admin.
model Media {
  id        String   @id @default(cuid())
  url       String
  publicId  String
  filename  String
  alt       String
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Key/value site settings: title, socials, accent color, availability, nav, footer.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Generic CMS pages: `blocks` is an ordered array of typed sections,
// so new sections/pages can be added from the admin without code changes.
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique // "home", "about", "uses", ...
  title     String
  blocks    Json
  updatedAt DateTime @updatedAt
}

model UsesItem {
  id          String @id @default(cuid())
  title       String
  description String @db.Text
  group       String?
  order       Int    @default(0)

  @@index([order])
}

// Optional newsletter (enabled via the `newsletter.enabled` setting).
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Files attached to a post (photo, video, document). Photos render inline
// on the public post page; videos and documents render as one button.
enum AttachmentKind {
  IMAGE
  VIDEO
  FILE
}

model PostAttachment {
  id        String         @id @default(cuid())
  postId    String
  post      Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  kind      AttachmentKind
  mimeType  String
  size      Int            @default(0)
  width     Int?
  height    Int?
  createdAt DateTime       @default(now())

  @@index([postId])
}

// Anonymous per-browser heartbeat for the dashboard's live visitor count.
// Only a random id and timestamps — no personal data (see app/api/visit).
model Visitor {
  id        String   @id // random id kept in the visitor's localStorage
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt

  @@index([lastSeen])
}

// Small counters, incremented atomically by app/api/visit (page views).
model Stat {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Rate-limit counters. Kept in the database so the limit is the same on
// every instance of the app: a serverless function's memory is not shared,
// so a counter that lives in memory counts per instance and not per user.
// Used for the limits that are a security boundary (license keys, sign-in)
// — the page-view beacon deliberately uses the cheaper in-memory counter.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

// Short links created in the admin (/admin/links). The public URL is
// /go/{code}; every hit is logged (IP + coarse location) in ShortLinkClick
// and then the visitor is redirected to `targetUrl`.
model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique
  targetUrl String
  title     String?
  active    Boolean  @default(true)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs ShortLinkClick[]

  @@index([createdAt])
}

// One row per short-link click. The IP plus the platform's geolocation
// request headers (Vercel sets x-vercel-ip-country/region/city) — no
// cookies, no fingerprinting, no prompts. City arrives URL-encoded,
// decoded on write. Short links redirect immediately, so this is the
// whole record: nothing is ever shown to the visitor.
model ShortLinkClick {
  id          String    @id @default(cuid())
  shortLinkId String
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  ip          String    @default("unknown")
  country     String?
  region      String?
  city        String?
  userAgent   String?
  referer     String?
  createdAt   DateTime  @default(now())

  @@index([shortLinkId, createdAt])
}

// ─── App licensing ──────────────────────────────────────────────────────
// The admin panel doubles as a license server for apps you build and ship.
// An app registers itself here, gets an API key, and its end users activate
// license keys through app/api/license/* — see lib/licensing.ts.

// One app you ship (desktop, mobile, web…). `apiKey` authenticates the app
// to the activation API. It travels in the app's own configuration, never
// in anything an end user sees, and can be rotated from the dashboard.
model App {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique // used as the key prefix: MYAPP-XXXX-…
  description String?
  apiKey      String      @unique // "appk_…"
  active      Boolean     @default(true)
  // What happens when the software asks for a key for someone's email:
  // AUTO emails a fresh key immediately (the default), REVIEW parks the
  // request until the admin approves it, OFF closes the door. Switch it to
  // OFF or REVIEW per app from the app's dashboard page.
  requestMode RequestMode @default(AUTO)
  // How long a token stays valid offline before the app must re-check with
  // the server. Shorter = a revoked licence stops working sooner, at the
  // cost of the app talking to the server more often. 1–90 days.
  recheckDays Int         @default(7)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  licenses    License[]
  keyRequests KeyRequest[]

  @@index([createdAt])
}

// OFF = requests refused; AUTO = key emailed straight away; REVIEW = the
// admin decides (KeyRequestStatus.PENDING).
enum RequestMode {
  OFF
  AUTO
  REVIEW
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
}

// One license key sold/given to a customer. Configurable per key: how many
// devices may activate it, and whether it expires (null = lifetime).
model License {
  id         String        @id @default(cuid())
  appId      String
  app        App           @relation(fields: [appId], references: [id], onDelete: Cascade)
  key        String        @unique // MYAPP-XXXX-XXXX-XXXX, shown in the dashboard
  label      String? // customer name / order reference
  email      String?
  notes      String?       @db.Text
  maxDevices Int           @default(1)
  expiresAt  DateTime? // null = lifetime
  status     LicenseStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  activations LicenseActivation[]
  requests    KeyRequest[]

  @@index([appId, status])
  @@index([createdAt])
}

// One device that activated a license. `deviceId` is a fingerprint the app
// computes locally (see the snippet in the dashboard) — the server never
// stores anything more identifying than that plus the request IP.
// `revoked` lets a single device be kicked without killing the whole key.
model LicenseActivation {
  id          String    @id @default(cuid())
  licenseId   String
  license     License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  deviceId    String
  deviceName  String?
  platform    String?
  ip          String?
  revoked     Boolean   @default(false)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt

  @@unique([licenseId, deviceId])
  @@index([licenseId, lastSeenAt])
}

// ─── Key requests and bans ──────────────────────────────────────────────

// One "email me a key" request from inside a shipped app
// (POST /api/license/request). Kept as an audit trail: what was asked for,
// whether it was answered, and why not, so the dashboard can show a request
// sitting in REVIEW and a failed delivery can be retried.
model KeyRequest {
  id         String           @id @default(cuid())
  appId      String
  app        App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  email      String // lowercased
  status     KeyRequestStatus @default(PENDING)
  note       String? // why it failed / was refused, and any admin note
  ip         String?
  platform   String?
  // The key this request produced, if any. Kept so "resend" can send the
  // same key again instead of minting a duplicate.
  licenseId  String?
  license    License?         @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([appId, status])
  @@index([email])
  @@index([createdAt])
}

enum KeyRequestStatus {
  PENDING // waiting for the admin (REVIEW mode), or delivery failed
  SENT // key emailed
  REJECTED // admin refused
  BLOCKED // banned email, or requests closed for the app
  FAILED // mail provider refused the send
}

// A denied email address or device id, checked on every request, activation
// and re-check (see banHit in lib/licensing.ts). Deliberately a separate
// table rather than a flag on a row: a ban is global — one device cannot be
// locked out of one app and allowed into another by accident.
model Ban {
  id         String   @id @default(cuid())
  kind       BanKind
  value      String // lowercased email, or the exact device id
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([kind, value])
  @@index([createdAt])
}

enum BanKind {
  EMAIL
  DEVICE
}
